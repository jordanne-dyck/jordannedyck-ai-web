# Copy to .env.local and fill in. Only OPENAI_API_KEY is needed to run the chat locally.
OPENAI_API_KEY=

# Flask backend (jordannedyck-ai). Defaults to http://localhost:5000.
FLASK_API_URL=

# Observability. Leave DATABASE_URL empty locally: logging and rate limiting are then skipped.
DATABASE_URL=
IP_HASH_SALT=
DASHBOARD_ADMIN_PASSWORD=

# Checkly: requests carrying this value in x-monitor-token are marked synthetic.
MONITOR_TOKEN=

# Evals only: include retrieved chunks in the chat stream. Never set in production.
EMIT_RETRIEVAL=
